<div class="container-fluid">
	<div class="row justify-content-center">
		<div class="col-sm-6 col-xl-4">
			<div class="mb-3">
				<label for="inputNome" class="form-label">Nome</label>
				<input type="text" class="form-control" id="inputNome" name="company_name" maxlength="100" />
			</div>
			<div class="mb-3">
				<label for="selectIndustria" class="form-label">Indústria</label>
				<select id="selectIndustria" class="form-select" name="industry">
					<option value="">Selecione...</option>
					<option>Financeiro</option>
					<option>Marketing</option>
					<option>Serviços</option>
					<option>Tecnologia</option>
					<option>Varejo</option>
				</select>
			</div>
			<div class="mb-3">
				<label for="selectTamanho" class="form-label">Tamanho</label>
				<select id="selectTamanho" class="form-select" name="company_size">
					<option value="">Selecione...</option>
					<option>Pequena</option>
					<option>Média</option>
					<option>Grande</option>
				</select>
			</div>
			<div class="mb-3">
				<label for="inputFuncionarios" class="form-label">Qtde Funcionários</label>
				<input type="number" id="inputFuncionarios" class="form-control" name="employee_count" min="1" />
			</div>
			<div>
				<button type="button" class="btn btn-primary" onclick="criarEmpresa()">Criar</button>
			</div>
		</div>
	</div>
</div>

<script>
	async function criarEmpresa() {

		let inputNome = document.getElementById("inputNome");
		let selectIndustria = document.getElementById("selectIndustria");
		let selectTamanho = document.getElementById("selectTamanho");
		let inputFuncionarios = document.getElementById("inputFuncionarios");

		let company_name = inputNome.value;
		let industry = selectIndustria.value;
		let company_size = selectTamanho.value;
		let employee_count = parseInt(inputFuncionarios.value);

		// Aqui vão as validações normais, como vimos antes... 😊

		let empresa = {
			company_name: company_name,
			industry: industry,
			company_size: company_size,
			employee_count: employee_count,
		};

		try {
			const response = await fetch("/api/empresa/criar", {
				method: "POST",
				headers: {
					"content-type": "application/json"
				},
				body: JSON.stringify(empresa),
			});

			const resultado = await response.json();

			if (resultado.ok) {
				alert("Sucesso");
			} else {
				alert("Erro");
			}
		} catch (ex) {
			alert("Exceção");
		}
	}
</script>
