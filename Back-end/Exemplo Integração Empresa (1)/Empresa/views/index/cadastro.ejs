<form id="formPessoa">
	<div>
		<label for="inputNome">Nome</label>
		<input type="text" id="inputNome" name="nome" maxlength="100" />
	</div>
	<div>
		<label for="inputEmail">E-mail</label>
		<input type="email" id="inputEmail" name="email" maxlength="100" />
	</div>
	<div>
		<label for="inputTelefone">Telefone</label>
		<input type="text" id="inputTelefone" name="telefone" maxlength="20" />
	</div>
	<div>
		<label for="inputAvatar">Avatar</label>
		<input type="file" id="inputAvatar" name="avatar" accept="image/jpeg" />
	</div>
	<div>
		<button type="button" onclick="criarPessoa()">Criar</button>
	</div>
</form>

<script>
	async function criarPessoa() {

		// Aqui vão as validações normais, como vimos antes... 😊

		// As diferenças em relação aos semestres anteriores...

		let formPessoa = document.getElementById("formPessoa");
		let formData = new FormData(formPessoa);

		try {
			const response = await fetch("/api/pessoa/criar", {
				method: "POST",
				body: formData
			});

			const resultado = await response.json();

			if (resultado.ok) {
				alert("Sucesso");
			} else {
				alert("Erro");
			}
		} catch (ex) {
			alert("Exceção");
		}
	}
</script>
